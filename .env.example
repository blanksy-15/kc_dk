# Copy this file to .env and replace the placeholder locally.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini

# Optional request controls
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Discord incoming webhooks (a bot token is not used)
DISCORD_WEEKLY_WEBHOOK_URL=
DISCORD_LEADERBOARD_WEBHOOK_URL=
DISCORD_TIMEOUT_SECONDS=15
