# Copy this file to .env and replace the placeholder locally.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini

# Optional request controls
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Discord incoming webhooks (a bot token is not used)
DISCORD_WEEKLY_WEBHOOK_URL=
DISCORD_LEADERBOARD_WEBHOOK_URL=
DISCORD_DRUNK_WEBHOOK_URL=
DISCORD_TIMEOUT_SECONDS=15

# Optional second persona; no call when ineligible or without a live destination
DRUNK_BOT_ENABLED=true
DRUNK_BOT_MINIMUM_FACT_PRIORITY=90
DRUNK_BOT_MINIMUM_STREAK_LENGTH=3
DRUNK_BOT_MAXIMUM_INTERJECTIONS_PER_WEEK=2
DRUNK_BOT_MAXIMUM_MEMBERS_TARGETED=2
DRUNK_BOT_MINIMUM_NUMBER_OF_ELIGIBLE_FACTS=1
DRUNK_BOT_ALLOW_PROFANITY=true
DRUNK_BOT_DEFAULT_TONE=ruthless
# Blank uses OPENAI_MODEL
DRUNK_BOT_OPENAI_MODEL=
